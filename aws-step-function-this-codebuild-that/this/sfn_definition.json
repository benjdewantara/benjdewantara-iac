{
  "QueryLanguage": "JSONata",
  "Comment": "A Hello World example of the Amazon States Language using an AWS Lambda Function",
  "StartAt": "HelloWorld",
  "States": {
    "HelloWorld": {
      "Type": "Pass",
      "Next": "ReadStepFunctionVariableExisting"
    },
    "ReadStepFunctionVariableExisting": {
      "Type": "Pass",
      "Next": "StartBuild Customer Account",
      "Assign": {
        "var1": "{% $states.input.text %}"
      }
    },
    "StartBuild Customer Account": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Arguments": {
        "ProjectName": "{% $states.input.ProjectNameCustomer %}"
      },
      "Credentials": {
        "RoleArn": "arn:aws:iam::931609664368:role/codebuild-beta-cb-starter"
      },
      "End": true
    }
  }
}