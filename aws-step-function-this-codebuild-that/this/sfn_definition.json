{
  "Comment": "A Hello World example of the Amazon States Language using an AWS Lambda Function",
  "StartAt": "HelloWorld",
  "States": {
    "HelloWorld": {
      "Type": "Pass",
      "Result": "Hello World 123!",
      "Next": "StartBuild Customer Account"
    },
    "StartBuild Customer Account": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Credentials": {
        "RoleArn": "${arn_iam_role_name_codebuild_starter}"
      },
      "End": true
    }
  }
}
